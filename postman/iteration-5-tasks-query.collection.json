              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{ownerAccessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"{{taskTitleB}}\",\n  \"description\": \"Task B for iteration 5\",\n  \"status\": \"IN_PROGRESS\",\n  \"priority\": \"MEDIUM\",\n  \"dueDate\": \"2026-03-20T10:00:00Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}/tasks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "projects",
                "{{projectId}}",
                "tasks"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('taskTitleB', 'Iteration 5 Task B ' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Task B created', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.eql(true);",
                  "    pm.expect(json.data.task.title).to.eql(pm.environment.get('taskTitleB'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/projects/{projectId}/tasks (create task C)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{ownerAccessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"{{taskTitleC}}\",\n  \"description\": \"Task C for iteration 5\",\n  \"status\": \"DONE\",\n  \"priority\": \"LOW\",\n  \"dueDate\": \"2026-03-25T10:00:00Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}/tasks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "projects",
                "{{projectId}}",
                "tasks"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('taskTitleC', 'Iteration 5 Task C ' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Task C created', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.eql(true);",
                  "    pm.expect(json.data.task.title).to.eql(pm.environment.get('taskTitleC'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/projects/{projectId}/tasks (due range + dueDate asc)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ownerAccessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}/tasks?dueFrom={{dueFromIso}}&dueTo={{dueToIso}}&sortBy=dueDate&sortOrder=asc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "projects",
                "{{projectId}}",
                "tasks"
              ],
              "query": [
                {
                  "key": "dueFrom",
                  "value": "{{dueFromIso}}"
                },
                {
                  "key": "dueTo",
                  "value": "{{dueToIso}}"
                },
                {
                  "key": "sortBy",
                  "value": "dueDate"
                },
                {
                  "key": "sortOrder",
                  "value": "asc"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Due range filter returns task B then task C', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.eql(true);",
                  "    pm.expect(json.data.tasks.length).to.eql(2);",
                  "    pm.expect(json.data.tasks[0].title).to.eql(pm.environment.get('taskTitleB'));",
                  "    pm.expect(json.data.tasks[1].title).to.eql(pm.environment.get('taskTitleC'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/projects/{projectId}/tasks (sort by priority asc)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ownerAccessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}/tasks?sortBy=priority&sortOrder=asc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "projects",
                "{{projectId}}",
                "tasks"
              ],
              "query": [
                {
                  "key": "sortBy",
                  "value": "priority"
                },
                {
                  "key": "sortOrder",
                  "value": "asc"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Priority sort order is LOW, MEDIUM, HIGH', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.eql(true);",
                  "    const priorities = json.data.tasks.slice(0, 3).map(function (t) { return t.priority; });",
                  "    pm.expect(priorities).to.eql(['LOW', 'MEDIUM', 'HIGH']);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/projects/{projectId}/tasks (invalid sortBy)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ownerAccessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}/tasks?sortBy=invalidField",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "projects",
                "{{projectId}}",
                "tasks"
              ],
              "query": [
                {
                  "key": "sortBy",
                  "value": "invalidField"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 422', function () {",
                  "    pm.response.to.have.status(422);",
                  "});",
                  "",
                  "pm.test('Validation error shape is returned', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.eql(false);",
                  "    pm.expect(json.statusCode).to.eql(422);",
                  "    pm.expect(json.message).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
