        {
          "name": "GET /api/projects/{projectId}/tasks (filter + pagination)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ownerAccessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}/tasks?status=TODO&priority=HIGH&assigneeId={{memberUserId}}&page=1&limit=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "projects",
                "{{projectId}}",
                "tasks"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "TODO"
                },
                {
                  "key": "priority",
                  "value": "HIGH"
                },
                {
                  "key": "assigneeId",
                  "value": "{{memberUserId}}"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "1"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('List endpoint returns pagination and filtered tasks', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.eql(true);",
                  "    pm.expect(json.data.tasks).to.be.an('array').that.has.lengthOf(1);",
                  "    pm.expect(json.data.pagination.page).to.eql(1);",
                  "    pm.expect(json.data.pagination.limit).to.eql(1);",
                  "    pm.expect(json.data.pagination.total).to.be.a('number').and.to.be.at.least(1);",
                  "    pm.expect(json.data.tasks[0].status).to.eql('TODO');",
                  "    pm.expect(json.data.tasks[0].priority).to.eql('HIGH');",
                  "    pm.expect(String(json.data.tasks[0].assignedUserId)).to.eql(pm.environment.get('memberUserId'));",
                  "});"
                ]
              }
            }
          ]
        },
