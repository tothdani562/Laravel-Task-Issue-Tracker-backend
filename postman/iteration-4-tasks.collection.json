        {
          "name": "POST /api/projects/{id}/members (owner add member)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{ownerAccessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"memberUserId\": {{memberUserId}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}/members",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "projects",
                "{{projectId}}",
                "members"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Member was added', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.eql(true);",
                  "    const memberId = pm.environment.get('memberUserId');",
                  "    const ids = json.data.project.members.map(function (m) { return String(m.id); });",
                  "    pm.expect(ids).to.include(memberId);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/projects/{projectId}/tasks (owner create task)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{ownerAccessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"{{taskTitle}}\",\n  \"description\": \"{{taskDescription}}\",\n  \"status\": \"TODO\",\n  \"priority\": \"HIGH\",\n  \"assignedUserId\": {{memberUserId}},\n  \"dueDate\": \"{{dueDateIso}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}/tasks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "projects",
                "{{projectId}}",
                "tasks"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('taskTitle', 'Iteration 4 Task ' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Task create response is valid', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.eql(true);",
                  "    pm.expect(json.data.task.title).to.eql(pm.environment.get('taskTitle'));",
                  "    pm.expect(String(json.data.task.projectId)).to.eql(pm.environment.get('projectId'));",
                  "    pm.expect(json.data.task.status).to.eql('TODO');",
                  "    pm.expect(json.data.task.priority).to.eql('HIGH');",
                  "    pm.expect(String(json.data.task.assignedUserId)).to.eql(pm.environment.get('memberUserId'));",
                  "});",
                  "",
                  "pm.test('Store task id', function () {",
                  "    const json = pm.response.json();",
                  "    pm.environment.set('taskId', String(json.data.task.id));",
                  "});"
                ]
              }
            }
          ]
        },
