          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const memberEmail = 'iteration3.member+' + Date.now() + '@example.com';",
                  "pm.environment.set('memberEmail', memberEmail);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Store member credentials', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.eql(true);",
                  "    pm.expect(json.data.user.email).to.eql(pm.environment.get('memberEmail'));",
                  "    pm.environment.set('memberAccessToken', json.data.accessToken);",
                  "    pm.environment.set('memberUserId', String(json.data.user.id));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/projects/{id}/members (owner add member)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{ownerAccessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"memberUserId\": {{memberUserId}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}/members",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "projects",
                "{{projectId}}",
                "members"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Member is attached to project', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.eql(true);",
                  "    pm.expect(json.data.project.members).to.be.an('array');",
                  "    const memberId = pm.environment.get('memberUserId');",
                  "    const ids = json.data.project.members.map(function (m) { return String(m.id); });",
                  "    pm.expect(ids).to.include(memberId);",
                  "});"
                ]
              }
            }
          ]
        },
