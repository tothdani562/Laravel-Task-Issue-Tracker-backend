        {
          "name": "PATCH /api/projects/{id} (member forbidden)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{memberAccessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Member cannot update\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "projects",
                "{{projectId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 403 for member update', function () {",
                  "    pm.response.to.have.status(403);",
                  "});",
                  "",
                  "pm.test('Forbidden response shape is valid', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.eql(false);",
                  "    pm.expect(json.statusCode).to.eql(403);",
                  "    pm.expect(json.message).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ]
        },
