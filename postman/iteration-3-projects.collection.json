  "item": [
    {
      "name": "03 Iteration 3",
      "item": [
        {
          "name": "GET /api",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has health payload', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.eql(true);",
                  "    pm.expect(json.data.service).to.eql('task-manager-api');",
                  "    pm.expect(json.data.status).to.eql('ok');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/auth/register (owner)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{ownerName}}\",\n  \"email\": \"{{ownerEmail}}\",\n  \"password\": \"{{registerPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const ownerEmail = 'iteration3.owner+' + Date.now() + '@example.com';",
                  "pm.environment.set('ownerEmail', ownerEmail);",
                  "pm.environment.set('ownerLoginEmail', ownerEmail);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Owner register response is valid', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.eql(true);",
                  "    pm.expect(json.data.user.email).to.eql(pm.environment.get('ownerEmail'));",
                  "    pm.expect(json.data.accessToken).to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "pm.test('Store owner credentials', function () {",
                  "    const json = pm.response.json();",
                  "    pm.environment.set('ownerAccessToken', json.data.accessToken);",
                  "    pm.environment.set('ownerUserId', String(json.data.user.id));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/projects (owner create project)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{ownerAccessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{projectName}}\",\n  \"description\": \"{{projectDescription}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/projects",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "projects"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('projectName', 'Iteration 3 Project ' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Project create response is valid', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.eql(true);",
                  "    pm.expect(json.data.project.name).to.eql(pm.environment.get('projectName'));",
                  "    pm.expect(String(json.data.project.ownerId)).to.eql(pm.environment.get('ownerUserId'));",
                  "    pm.expect(json.data.project.members).to.be.an('array').that.has.lengthOf(0);",
                  "});",
                  "",
                  "pm.test('Store project id', function () {",
                  "    const json = pm.response.json();",
                  "    pm.environment.set('projectId', String(json.data.project.id));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/projects/{id} (owner)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ownerAccessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "projects",
                "{{projectId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Owner can see project', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.eql(true);",
                  "    pm.expect(String(json.data.project.id)).to.eql(pm.environment.get('projectId'));",
                  "});"
                ]
              }
            }
          ]
        },
