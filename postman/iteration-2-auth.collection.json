{
  "info": {
    "_postman_id": "9b2fa3d1-c4dc-4b22-a8f0-7a9f4dd2a6d3",
    "name": "Laravel Eloquent - Iteration 2 Auth",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "02 Iteration 2",
      "item": [
        {
          "name": "GET /api",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has health payload', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.eql(true);",
                  "    pm.expect(json.data.service).to.eql('task-manager-api');",
                  "    pm.expect(json.data.status).to.eql('ok');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/auth/register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{registerName}}\",\n  \"email\": \"{{registerEmail}}\",\n  \"password\": \"{{registerPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const email = 'iteration2+' + Date.now() + '@example.com';",
                  "pm.environment.set('registerEmail', email);",
                  "pm.environment.set('loginEmail', email);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Register response shape is valid', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.eql(true);",
                  "    pm.expect(json.data.user.email).to.eql(pm.environment.get('registerEmail'));",
                  "    pm.expect(json.data.accessToken).to.be.a('string').and.not.empty;",
                  "    pm.expect(json.data.refreshToken).to.be.a('string').and.not.empty;",
                  "    pm.expect(json.data.tokenType).to.eql('Bearer');",
                  "    pm.expect(json.data.expiresIn).to.be.a('number');",
                  "    pm.expect(json.data.refreshExpiresIn).to.be.a('number');",
                  "});",
                  "",
                  "pm.test('Store auth values from register', function () {",
                  "    const json = pm.response.json();",
                  "    pm.environment.set('accessToken', json.data.accessToken);",
                  "    pm.environment.set('refreshToken', json.data.refreshToken);",
                  "    pm.environment.set('userId', String(json.data.user.id));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/auth/login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{loginEmail}}\",\n  \"password\": \"{{registerPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Login response shape is valid', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.eql(true);",
                  "    pm.expect(json.data.user.email).to.eql(pm.environment.get('loginEmail'));",
                  "    pm.expect(json.data.accessToken).to.be.a('string').and.not.empty;",
                  "    pm.expect(json.data.refreshToken).to.be.a('string').and.not.empty;",
                  "    pm.expect(json.data.tokenType).to.eql('Bearer');",
                  "});",
                  "",
                  "pm.test('Store auth values from login', function () {",
                  "    const json = pm.response.json();",
                  "    pm.environment.set('accessToken', json.data.accessToken);",
                  "    pm.environment.set('refreshToken', json.data.refreshToken);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/auth/me (no token)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 401 without token', function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test('Standard error shape for unauthenticated request', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.eql(false);",
                  "    pm.expect(json.statusCode).to.eql(401);",
                  "    pm.expect(json.message).to.be.a('string').and.not.empty;",
                  "    pm.expect(json.path).to.be.a('string').and.to.match(/^\\/);",
                  "    pm.expect(json.timestamp).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/auth/me (with token)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 with access token', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Me response contains current user', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.eql(true);",
                  "    pm.expect(json.data.user).to.be.an('object');",
                  "    pm.expect(String(json.data.user.id)).to.eql(pm.environment.get('userId'));",
                  "    pm.expect(json.data.user.email).to.eql(pm.environment.get('loginEmail'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/auth/refresh (valid)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "refresh"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Refresh response shape is valid', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.eql(true);",
                  "    pm.expect(json.data.accessToken).to.be.a('string').and.not.empty;",
                  "    pm.expect(json.data.refreshToken).to.be.a('string').and.not.empty;",
                  "    pm.expect(json.data.tokenType).to.eql('Bearer');",
                  "    pm.expect(json.data.expiresIn).to.be.a('number');",
                  "    pm.expect(json.data.refreshExpiresIn).to.be.a('number');",
                  "});",
                  "",
                  "pm.test('Store rotated refresh token and new access token', function () {",
                  "    const json = pm.response.json();",
                  "    pm.environment.set('previousRefreshToken', pm.environment.get('refreshToken') || '');",
                  "    pm.environment.set('accessToken', json.data.accessToken);",
                  "    pm.environment.set('refreshToken', json.data.refreshToken);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/auth/logout (with access token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "logout"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Logout response is successful', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.eql(true);",
                  "    pm.expect(json.data.message).to.eql('Logged out successfully.');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/auth/refresh (after logout, should fail)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "refresh"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 401 after logout', function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test('Refresh is invalidated after logout', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.eql(false);",
                  "    pm.expect(json.statusCode).to.eql(401);",
                  "    pm.expect(json.message).to.eql('Invalid refresh token.');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    }
  ]
}
