{
  "info": {
    "_postman_id": "b29e65d5-7f98-47a5-a504-0fca804eecdb",
    "name": "Laravel Eloquent - Iteration 7 Auth Hardening",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "07 Iteration 7",
      "item": [
        {
          "name": "GET /api",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Health response shape is valid', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.eql(true);",
                  "    pm.expect(json.data.service).to.eql('task-manager-api');",
                  "    pm.expect(json.data.status).to.eql('ok');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/auth/register (security user)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{securityUserName}}\",\n  \"email\": \"{{securityUserEmail}}\",\n  \"password\": \"{{registerPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const email = 'iteration7.security+' + Date.now() + '@example.com';",
                  "pm.environment.set('securityUserEmail', email);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Store security user tokens', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.eql(true);",
                  "    pm.environment.set('securityAccessToken', json.data.accessToken);",
                  "    pm.environment.set('securityRefreshToken', json.data.refreshToken);",
                  "    pm.environment.set('securityUserId', String(json.data.user.id));",
                  "    pm.environment.set('loginRateLimitCounter', '0');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/auth/me (valid token)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{securityAccessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('/auth/me returns the logged in user', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.eql(true);",
                  "    pm.expect(String(json.data.user.id)).to.eql(pm.environment.get('securityUserId'));",
                  "    pm.expect(json.data.user.email).to.eql(pm.environment.get('securityUserEmail'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/auth/refresh (with access token should fail)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{securityAccessToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "refresh"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 401', function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test('Access token cannot be used as refresh token', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.eql(false);",
                  "    pm.expect(json.message).to.eql('Invalid refresh token.');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/auth/me (malformed token should fail)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer malformed.token.value"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 401', function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test('Malformed bearer token is rejected', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.eql(false);",
                  "    pm.expect(json.statusCode).to.eql(401);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/auth/login (rate-limit stress)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{securityUserEmail}}\",\n  \"password\": \"{{invalidPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const status = pm.response.code;",
                  "const loopMax = Number(pm.environment.get('loginRateLimitLoopMax') || '11');",
                  "const counter = Number(pm.environment.get('loginRateLimitCounter') || '0') + 1;",
                  "pm.environment.set('loginRateLimitCounter', String(counter));",
                  "",
                  "if (status === 401) {",
                  "    pm.test('Invalid credentials before hitting rate limit', function () {",
                  "        const json = pm.response.json();",
                  "        pm.expect(json.success).to.eql(false);",
                  "        pm.expect(json.message).to.eql('Invalid credentials.');",
                  "    });",
                  "",
                  "    if (counter < loopMax) {",
                  "        postman.setNextRequest('POST /api/auth/login (rate-limit stress)');",
                  "    } else {",
                  "        pm.test('Rate limit should trigger before loop max', function () {",
                  "            pm.expect.fail('Did not hit HTTP 429 within configured attempts.');",
                  "        });",
                  "    }",
                  "}",
                  "",
                  "if (status === 429) {",
                  "    pm.test('Status code is 429', function () {",
                  "        pm.response.to.have.status(429);",
                  "    });",
                  "",
                  "    pm.test('Rate limit error shape is valid', function () {",
                  "        const json = pm.response.json();",
                  "        pm.expect(json.success).to.eql(false);",
                  "        pm.expect(json.statusCode).to.eql(429);",
                  "        pm.expect(json.message).to.eql('Too many requests.');",
                  "    });",
                  "",
                  "    pm.environment.set('loginRateLimitCounter', '0');",
                  "    postman.setNextRequest(null);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "OPTIONS /api/auth/login (CORS preflight)",
          "request": {
            "method": "OPTIONS",
            "header": [
              {
                "key": "Origin",
                "value": "{{corsOrigin}}"
              },
              {
                "key": "Access-Control-Request-Method",
                "value": "POST"
              },
              {
                "key": "Access-Control-Request-Headers",
                "value": "Authorization, Content-Type"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 or 204', function () {",
                  "    pm.expect([200, 204]).to.include(pm.response.code);",
                  "});",
                  "",
                  "pm.test('CORS allow-origin matches configured origin', function () {",
                  "    const allowOrigin = pm.response.headers.get('Access-Control-Allow-Origin');",
                  "    pm.expect(allowOrigin).to.eql(pm.environment.get('corsOrigin'));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
